<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>InPoint.Cloud.OpenBarcode.Cli</AssemblyName>
    <RootNamespace>InPoint.Cloud.OpenBarcode.Cli</RootNamespace>
    <!-- Not published: the CLI is for trying the library out from source. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenBarcode\OpenBarcode.csproj" />
  </ItemGroup>

</Project>
