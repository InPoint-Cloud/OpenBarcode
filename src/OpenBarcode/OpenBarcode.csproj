<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>InPoint.Cloud.OpenBarcode</RootNamespace>
    <AssemblyName>InPoint.Cloud.OpenBarcode</AssemblyName>

    <PackageId>InPoint.Cloud.OpenBarcode</PackageId>
    <Description>Pure managed .NET barcode reader for images (PNG, JPEG, BMP, GIF, TIFF, ...) and PDF files. No native dependencies.</Description>
    <PackageTags>barcode;qr;qrcode;datamatrix;pdf417;code128;ean;upc;pdf;reader;scanner</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PdfPig.Filters.Jbig2.PdfboxJbig2" Version="0.1.16.2" />
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

</Project>
